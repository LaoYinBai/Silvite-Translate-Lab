# MiMo API Key（仅服务端 Cloud Function 读取，禁止使用 VITE_ 前缀）
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# GLM（智谱）API Key：只在高级菜单选择 GLM-4.6V-Flash 时使用。
# 与 MIMO_API_KEY 一样，只从服务端环境变量读取，禁止使用 VITE_ 前缀。
GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# 以下为可选覆盖，不填则使用代码内默认值（cloud-functions/api/translate.js 的 PROVIDER_DEFINITIONS）
# GLM_MODEL=glm-4.6v-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# GLM_MAX_COMPLETION_TOKENS=32768
# GLM_BUDGET_PARAM=max_tokens
# MIMO_MODEL=mimo-v2.5
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions
# MIMO_MAX_COMPLETION_TOKENS=65536
