# 只在服务端 Cloud Function 配置，禁止使用 VITE_ 前缀。
# 翻译候选只有 DeepSeek Flash 和 GLM 5.3 Flash，默认 DeepSeek。
# 同一网关的两个模型共用以下请求地址和 Key。
DEEPSEEK_API_KEY=your_deepseek_api_key
# 可填 OpenAI Chat Completions 兼容网关的基础地址或完整请求地址。
# 基础地址自动追加 /chat/completions；查询参数原样保留。
DEEPSEEK_BASE_URL=https://your-gateway.example/v1
# 默认模型 deepseek-flash；请求始终发送 thinking: { type: disabled }。
# 模型 ID 固定为 deepseek-flash / glm-5.3-flash，与实际网关目录一致。
# DEEPSEEK_MAX_COMPLETION_TOKENS=65536
# DEEPSEEK_BUDGET_PARAM=max_tokens

# 仅在线 MiMo ASR 使用，MiMo 不再作为翻译候选；浏览器 Zipformer 不需要 Key。
MIMO_API_KEY=your_mimo_api_key

# 详细部署说明：docs/model-providers.md

# 实时翻译限流（可选；每个 Cloud Function 实例内的短期进程级窗口，不是全局配额）
# REALTIME_ASR_RATE_LIMIT=90
# REALTIME_TRANSLATE_RATE_LIMIT=60
# REALTIME_RATE_LIMIT_WINDOW_MS=60000
